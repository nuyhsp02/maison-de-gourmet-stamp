[Unit]
Description=Check approved backup expiry and the fixed PROD event cutoff

[Timer]
OnCalendar=*-*-* 00:00:00 Asia/Seoul
OnCalendar=2027-03-31 00:00:00 Asia/Seoul
OnBootSec=1min
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=maison-custody-expire.service

[Install]
WantedBy=timers.target
